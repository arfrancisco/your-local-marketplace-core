# Base URL of the Rails API. Defaults to the local dev server if unset.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Base URL for the customer-web app, used by the tab bar's Marketplace link
# (TabBar.tsx). Defaults to the relative path '', correct in production
# where both apps share one origin. Only set this for local dev, where
# customer-web runs as its own dev server on a different port/origin —
# e.g. VITE_CUSTOMER_WEB_BASE_URL=http://localhost:5173
# VITE_CUSTOMER_WEB_BASE_URL=
