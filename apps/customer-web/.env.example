# Base URL of the Rails API. Defaults to the local dev server if unset.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Base URL for the vendor-web app, used by the "become a vendor" redirect
# (AccountPage.tsx). Defaults to the relative path /vendor, correct in
# production where both apps share one origin. Only set this for local dev,
# where vendor-web runs as its own dev server on a different port/origin —
# e.g. VITE_VENDOR_WEB_BASE_URL=http://localhost:5174
# VITE_VENDOR_WEB_BASE_URL=

# Beta-launch toggle (see LoginPage.tsx): skips the mobile-verification
# screen during registration when "true". Temporary, while SMS delivery is
# unreliable (Semaphore sender-name approval pending) — unset/false to
# restore the full 3-screen flow. Baked in at build time (Vite), so setting
# this requires a rebuild, not just an env change at runtime.
# VITE_SKIP_VERIFICATION=
