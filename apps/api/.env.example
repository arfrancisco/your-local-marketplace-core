# Copy to .env for local overrides. The defaults in config match docker-compose,
# so an out-of-the-box `docker compose up` + `bin/rails db:setup` works with none
# of these set. Production (Railway) sets them as real secrets.

# --- Database (defaults match docker-compose.yml) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=marketplace
DATABASE_PASSWORD=marketplace
DATABASE_NAME=marketplace_development
DATABASE_NAME_TEST=marketplace_test
# Railway provides a full DATABASE_URL in production; it overrides the above.
# DATABASE_URL=

# --- Redis / Sidekiq ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS: comma-separated origins allowed to call the API from a browser ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Cloudflare R2 (Active Storage, production), see ADR 0006 ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=

# --- Sidekiq web dashboard basic-auth (production only) ---
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# --- Verification code delivery: Semaphore (SMS) + Resend (email) ---
# Both optional in dev/test — VerificationDeliveryJob just logs the code if
# these are blank, same as before any provider was wired up.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
# Until a custom domain is verified in Resend, this must be their shared
# test sender, e.g. EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_ADDRESS=

# --- Beta feedback notification email (optional; reuses the Resend vars above) ---
# Where FeedbackNotificationJob sends a best-effort email ping for new
# submissions. Feedback is always stored in the DB regardless of this.
FEEDBACK_NOTIFICATION_EMAIL=

# --- e2e test helper (never enable in production) ---
# ENABLE_TEST_HELPERS=true

# --- Beta-launch toggle (see Vendors::EligibilityCheck) ---
# Skips the email-verified requirement to become a vendor, while SMS/email
# verification delivery is unreliable (Semaphore sender-name approval
# pending). Set in Railway directly (no rebuild needed) — unset to restore
# the requirement. See also VITE_SKIP_VERIFICATION in customer-web, which
# is baked in at build time and needs a rebuild to change.
# SKIP_VERIFICATION=true
