# Copy to .env for local use, or pass via `claude mcp add --env` at registration.
# Never commit real values.
ADMIN_API_BASE_URL=https://prisma.kapitmarket.ph/api/v1

# Bearer token for a real AdminUser account. admin-mcp is a long-running
# local process with no interactive login flow, so it takes a pre-minted
# token rather than an email/password pair. Two ways to get one:
#
#   1. Standard 30-day token via the real login endpoint (same as admin-web):
#        curl -X POST "$ADMIN_API_BASE_URL/admin/auth/login" \
#          -H 'Content-Type: application/json' \
#          -d '{"email":"you@example.com","password":"..."}'
#      then copy the `token` field from the response.
#
#   2. Longer-lived token (default 180 days) via the backend rake task,
#      minted out-of-band with server/rake access:
#        bin/rails "admin_users:mint_token[you@example.com,180]"
#
ADMIN_TOKEN=
